# Minimal bootstrap config for first startup.
# Most product and operational settings are now managed in the admin UI:
#   /#/admin/settings
#
# Loading behavior:
# - Built-in defaults are embedded in the binary
# - This file only overrides the bootstrap-critical parts
# - Ports / DB / Redis / feature selection stay file-based

App:
  RunMode: debug

Features:
  Default: ["Web", "Frontend:EmbedWeb", "Meili", "LocalOSS", "BigCacheIndex", "LoggerFile"]

WebServer:
  HttpIp: 0.0.0.0
  HttpPort: 8008

Database:
  LogLevel: error
  TablePrefix: p_
  MaxIdleConns: 10
  MaxOpenConns: 30

Postgres:
  Host: 127.0.0.1
  Port: 5432
  User: paopao
  Password: paopao           # 仅本地开发用的弱口令，与 docker-compose.dev.yml 保持一致
  Dbname: websitecore
  sslmode: disable

Redis:
  InitAddress:
    - 127.0.0.1:6379

JWT:
  Secret: ""   # 必填! 运行前生成: openssl rand -hex 24 (留空启动会直接报错退出)
  Issuer: paopao-api
  Expire: 86400

AdminSettings:
  EncryptionKey: "CHANGE-ME-TO-A-LONG-RANDOM-SECRET"

# Optional first-boot overrides for the providers enabled in Features.Default.
# If the embedded defaults already match your environment, you can remove these
# and manage later adjustments from /#/admin/settings.
Meili:
  Host: 127.0.0.1:7700
  Index: paopao-data
  ApiKey: paopao-meilisearch
  Secure: false

LocalOSS:
  SavePath: custom/data/paopao-ce/oss
  Secure: false
  Bucket: paopao
  Domain: 127.0.0.1:8008

Audit:
  Enabled: true                   # 是否开启内容审核，开启后普通用户新帖需审核通过后公开
Operator:
  Username: kiana                 # 运维账号名
  Password: ""                    # 运维账号密码(6-16位)，账号不存在时创建；已存在且与配置不一致时重置
